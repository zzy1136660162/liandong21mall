<view class="category-list">
  <view
    wx:for="{{categories}}"
    wx:key="id"
    class="category-item {{selectedCategory === item.id ? 'active' : ''}}"
    bindtap="selectCategory"
    data-id="{{item.id}}"
    data-name="{{item.name}}"
  >
    <text class="category-icon">{{item.icon}}</text>
    <text class="category-text">{{item.name}}</text>
  </view>
</view>