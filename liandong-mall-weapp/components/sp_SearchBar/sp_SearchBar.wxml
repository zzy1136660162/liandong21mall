<view class="sp-taobao-search">
  <!-- 搜索头部 -->
  <view class="search-header">
    <view class="search-input-wrap {{isFocus ? 'focus' : ''}}">
      <view class="search-icon-wrap">
        <text class="icon">🔍</text>
      </view>
      <input
        class="search-input"
        type="text"
        value="{{searchKey}}"
        placeholder="{{placeholder}}"
        placeholder-class="placeholder"
        confirm-type="search"
        bindinput="onInput"
        bindfocus="onFocus"
        bindblur="onBlur"
        bindconfirm="onConfirm"
      />
      <view class="clear-btn" wx:if="{{searchKey}}" bindtap="onClear">
        <text class="clear-icon">✕</text>
      </view>
    </view>
    <view class="cancel-btn" bindtap="onCancel">取消</view>
  </view>

  <!-- 搜索建议列表 -->
  <view class="suggestions-wrap" wx:if="{{showSuggestions}}">
    <!-- 加载中 -->
    <view class="loading-wrap" wx:if="{{searching}}">
      <text class="loading-text">搜索中...</text>
    </view>

    <!-- 建议列表 -->
    <view class="suggestion-list" wx:if="{{!searching && suggestions.length > 0}}">
      <view
        class="suggestion-item"
        wx:for="{{suggestions}}"
        wx:key="productId"
        bindtap="onSuggestionTap"
        data-id="{{item.productId || item.id}}"
        data-name="{{item.productName || item.name}}"
      >
        <view class="suggestion-left">
          <text class="suggestion-icon">🔍</text>
          <text class="suggestion-name">{{item.productName || item.name}}</text>
        </view>
        <text class="suggestion-price">¥{{item.memberPrice || item.price}}</text>
      </view>
    </view>

    <!-- 空结果 -->
    <view class="empty-wrap" wx:if="{{!searching && suggestions.length === 0 && searchKey}}">
      <text class="empty-text">未找到相关商品</text>
    </view>
  </view>

  <!-- 搜索页面（历史+热门） -->
  <view class="search-page" wx:if="{{showSearchPage && !searchKey}}">
    <!-- 历史搜索 -->
    <view class="history-wrap" wx:if="{{showHistory && historyList.length > 0}}">
      <view class="section-header">
        <text class="section-title">搜索历史</text>
        <view class="clear-btn" bindtap="onClearHistory">
          <text class="clear-text">清空</text>
        </view>
      </view>
      <view class="history-list">
        <view
          class="history-item"
          wx:for="{{historyList}}"
          wx:key="index"
          bindtap="onHistoryTap"
          data-keyword="{{item}}"
        >
          <text>{{item}}</text>
          <view class="delete-btn" catchtap="onDeleteHistory" data-keyword="{{item}}">
            <text>✕</text>
          </view>
        </view>
      </view>
    </view>

    <!-- 热门搜索 -->
    <view class="hot-wrap" wx:if="{{showHot}}">
      <view class="section-header">
        <text class="section-title">🔥 热门搜索</text>
      </view>
      <view class="hot-list">
        <view
          class="hot-item"
          wx:for="{{hotList}}"
          wx:key="index"
          bindtap="onHotTap"
          data-keyword="{{item}}"
        >
          <text>{{item}}</text>
        </view>
      </view>
    </view>

    <!-- 空状态 -->
    <view class="empty-wrap" wx:if="{{(!showHistory || historyList.length === 0) && !showHot}}">
      <text class="empty-text">暂无搜索记录</text>
    </view>
  </view>
</view>
