<view class="sp-home-talent-pool">
  <view class="section-header">
    <view class="header-left">
      <text class="section-icon">👨‍🔬</text>
      <text class="section-title">{{title}}</text>
    </view>
    <view class="header-right" bindtap="goToTalentList" wx:if="{{showMore}}">
      <text class="more-text">查看更多</text>
      <text class="arrow">></text>
    </view>
  </view>

  <view class="talent-list" wx:if="{{!loading && !error && talents.length > 0}}">
    <view class="talent-grid">
      <view 
        wx:for="{{talents}}" 
        wx:key="id"
        class="talent-card"
        bindtap="goToTalentDetail"
        data-id="{{item.id}}"
      >
        <view class="talent-avatar-wrapper">
          <image 
            class="talent-avatar" 
            src="{{item.avatar}}" 
            mode="aspectFill"
            lazy-load="{{true}}"
          />
        </view>
        <view class="talent-info">
          <text class="talent-name">{{item.name}}</text>
          <text class="talent-title">{{item.title}}</text>
          <view class="talent-tags">
            <text class="tag" wx:for="{{item.expertiseAreas}}" wx:key="index" wx:for-item="tag">{{tag}}</text>
          </view>
        </view>
      </view>
    </view>
  </view>

  <view class="loading-state" wx:if="{{loading}}">
    <text class="loading-text">加载中...</text>
  </view>

  <view class="error-state" wx:if="{{error}}">
    <text class="error-text">{{error}}</text>
    <text class="retry-btn" bindtap="refresh">点击重试</text>
  </view>

  <view class="empty-state" wx:if="{{!loading && !error && talents.length === 0}}">
    <text class="empty-text">暂无人才信息</text>
  </view>
</view>
