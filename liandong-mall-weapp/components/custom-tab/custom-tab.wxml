<view class="custom-tab-container">
  <view 
    wx:for="{{tabs}}" 
    wx:key="id"
    class="tab-item {{activeTab === item.id ? 'active' : ''}}"
    bindtap="onTabChange"
    data-id="{{item.id}}"
    data-url="{{item.url}}"
  >
    <view class="tab-icon-wrapper">
      <image 
        class="tab-icon" 
        src="{{activeTab === item.id ? item.selectedIcon : item.normalIcon}}" 
        mode="aspectFit"
      />
      <view class="tab-badge" wx:if="{{item.badge > 0}}">
        <text class="badge-text">{{item.badge > 99 ? '99+' : item.badge}}</text>
      </view>
    </view>
    <text class="tab-label">{{item.name}}</text>
  </view>
</view>
