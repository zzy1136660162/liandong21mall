<view class="page">
  <!-- 顶部白色区域 -->
  <view class="header">
    <!-- 搜索栏 -->
  <view class="search-bar">
    <view class="search-input-box" bindtap="goToSearch">
      <text class="search-icon">🔍</text>
      <view class="search-input-wrapper">
        <input class="search-input" placeholder="搜索商品" placeholder-class="placeholder" 
               confirm-type="search" disabled/>
        <image class="camera-btn" src="https://www.lslnii.com/upload/NFSImgFile/appl/images/2025/12/20260319090524623_666695127685.png" mode="aspectFit" catchtap="goToCamera"></image>
      </view>
    </view>
  </view>

    <!-- 分类标签 -->
    <scroll-view class="category-scroll" scroll-x enhanced show-scrollbar="{{false}}">
      <view class="category-list">
        <view class="category-item {{currentCategory === 'all' ? 'active' : ''}}" bindtap="switchCategory" data-category="all">
          <text class="category-text">首页</text>
        </view>
        <view class="category-item {{currentCategory === 'nasal_care' ? 'active' : ''}}" bindtap="goToCategory" data-category="nasal_care">
          <text class="category-text">鼻部护理</text>
        </view>
        <view class="category-item {{currentCategory === 'pain_relief' ? 'active' : ''}}" bindtap="goToCategory" data-category="pain_relief">
          <text class="category-text">缓解疼痛</text>
        </view>
        <view class="category-item {{currentCategory === 'eye_care' ? 'active' : ''}}" bindtap="goToCategory" data-category="eye_care">
          <text class="category-text">护眼</text>
        </view>
        <view class="category-item {{currentCategory === 'sub_health' ? 'active' : ''}}" bindtap="goToCategory" data-category="sub_health">
          <text class="category-text">调理亚健康</text>
        </view>
        <view class="category-item {{currentCategory === 'kidney_care' ? 'active' : ''}}" bindtap="goToCategory" data-category="kidney_care">
          <text class="category-text">固肾养肾</text>
        </view>
        <view class="category-item {{currentCategory === 'body_odor' ? 'active' : ''}}" bindtap="goToCategory" data-category="body_odor">
          <text class="category-text">狐臭护理</text>
        </view>
        <view class="category-item {{currentCategory === 'skin_care' ? 'active' : ''}}" bindtap="goToCategory" data-category="skin_care">
          <text class="category-text">美肤护肤</text>
        </view>
        <view class="category-item {{currentCategory === 'facial_rehab' ? 'active' : ''}}" bindtap="goToCategory" data-category="facial_rehab">
          <text class="category-text">面瘫康复</text>
        </view>
        <view class="category-item {{currentCategory === 'women_health' ? 'active' : ''}}" bindtap="goToCategory" data-category="women_health">
          <text class="category-text">女性调理</text>
        </view>
        <view class="category-item {{currentCategory === 'solid_drink' ? 'active' : ''}}" bindtap="goToCategory" data-category="solid_drink">
          <text class="category-text">固体饮料</text>
        </view>
        <view class="category-item {{currentCategory === 'tablet_candy' ? 'active' : ''}}" bindtap="goToCategory" data-category="tablet_candy">
          <text class="category-text">压片糖果</text>
        </view>
        <view class="category-item {{currentCategory === 'herbal_paste' ? 'active' : ''}}" bindtap="goToCategory" data-category="herbal_paste">
          <text class="category-text">膏滋</text>
        </view>
        <view class="category-item {{currentCategory === 'herbal_drink' ? 'active' : ''}}" bindtap="goToCategory" data-category="herbal_drink">
          <text class="category-text">植物饮品</text>
        </view>
        <view class="category-item {{currentCategory === 'prepared_wine' ? 'active' : ''}}" bindtap="goToCategory" data-category="prepared_wine">
          <text class="category-text">配制酒</text>
        </view>
        <view class="category-item {{currentCategory === 'tea_substitute' ? 'active' : ''}}" bindtap="goToCategory" data-category="tea_substitute">
          <text class="category-text">代用茶</text>
        </view>
      </view>
    </scroll-view>
  </view>

  <!-- Banner 轮播图 -->
  <view class="banner-section">
    <swiper class="banner-swiper" indicator-dots autoplay circular interval="3500" duration="500" indicator-color="rgba(255,255,255,0.5)" indicator-active-color="#ff5000">
      <swiper-item wx:for="{{banners}}" wx:key="id" bindtap="onBannerTap" data-item="{{item}}">
        <image class="banner-image" src="{{item.image}}" mode="aspectFill"/>
        <view class="banner-content">
          <text class="banner-title">{{item.title}}</text>
          <text class="banner-subtitle" wx:if="{{item.subtitle}}">{{item.subtitle}}</text>
        </view>
      </swiper-item>
    </swiper>
  </view>

  <!-- 快捷入口 - 5个图标 -->
  <view class="quick-entry">
    <view class="entry-list">
      <view class="entry-item" bindtap="onEntryTap" data-type="hot">
        <image class="entry-icon" src="https://www.lslnii.com/upload/NFSImgFile/appl/images/2025/12/20260313142047334_666195650315.png" mode="aspectFit"/>
        <text class="entry-name">超级爆品</text>
      </view>
      <view class="entry-item" bindtap="onEntryTap" data-type="follow">
        <image class="entry-icon" src="https://www.lslnii.com/upload/NFSImgFile/appl/images/2025/12/20260313142240238_666195763220.png" mode="aspectFit"/>
        <text class="entry-name">同行跟选</text>
      </view>
      <view class="entry-item" bindtap="onEntryTap" data-type="video">
        <image class="entry-icon" src="https://www.lslnii.com/upload/NFSImgFile/appl/images/2025/12/20260313142605000_666195967983.png" mode="aspectFit"/>
        <text class="entry-name">视频热卖</text>
      </view>
      <view class="entry-item" bindtap="onEntryTap" data-type="merchant">
        <image class="entry-icon" src="https://www.lslnii.com/upload/NFSImgFile/appl/images/2025/12/20260313142853275_666196136259.png" mode="aspectFit"/>
        <text class="entry-name">商家优选</text>
      </view>
      <view class="entry-item" bindtap="onEntryTap" data-type="cheap">
        <image class="entry-icon" src="https://www.lslnii.com/upload/NFSImgFile/appl/images/2025/12/20260313145940320_666197983305.png" mode="aspectFit"/>
        <text class="entry-name">低价好卖</text>
      </view>
    </view>
  </view>

  <!-- 筛选栏 -->
  <view class="filter-section">
    <view class="filter-bar">
      <view class="filter-item {{currentFilter === 'all' ? 'active' : ''}}" bindtap="switchFilter" data-filter="all">
        <text>精选</text>
      </view>
      <view class="filter-item {{currentFilter === 'hot' ? 'active' : ''}}" bindtap="switchFilter" data-filter="hot">
        <text>热销</text>
      </view>
      <view class="filter-item {{currentFilter === 'new' ? 'active' : ''}}" bindtap="switchFilter" data-filter="new">
        <text>新品</text>
      </view>
      <view class="filter-item {{currentFilter === 'commission' ? 'active' : ''}}" bindtap="switchFilter" data-filter="commission">
        <text>高佣</text>
      </view>
    </view>
    <view class="filter-more" bindtap="toggleFilterPanel">
      <text>筛选</text>
      <text class="arrow">▼</text>
    </view>
  </view>

  <!-- 二级筛选面板 -->
  <view class="sub-filter-panel" wx:if="{{showFilterPanel}}">
    <view class="sub-filter-section">
      <text class="sub-filter-title">佣金比例</text>
      <view class="sub-filter-options">
        <view class="sub-filter-item {{currentFilters.commission === item.value ? 'active' : ''}}" 
              wx:for="{{filterOptions.commission}}" wx:key="value"
              bindtap="selectSubFilter" data-type="commission" data-value="{{item.value}}">
          {{item.label}}
        </view>
      </view>
    </view>
    <view class="sub-filter-section">
      <text class="sub-filter-title">价格区间</text>
      <view class="sub-filter-options">
        <view class="sub-filter-item {{currentFilters.price === item.value ? 'active' : ''}}" 
              wx:for="{{filterOptions.price}}" wx:key="value"
              bindtap="selectSubFilter" data-type="price" data-value="{{item.value}}">
          {{item.label}}
        </view>
      </view>
    </view>
    <view class="sub-filter-section">
      <text class="sub-filter-title">销量</text>
      <view class="sub-filter-options">
        <view class="sub-filter-item {{currentFilters.sales === item.value ? 'active' : ''}}" 
              wx:for="{{filterOptions.sales}}" wx:key="value"
              bindtap="selectSubFilter" data-type="sales" data-value="{{item.value}}">
          {{item.label}}
        </view>
      </view>
    </view>
  </view>

  <!-- 商品列表 -->
  <view class="product-list">
    <view class="product-item" wx:for="{{products}}" wx:key="id">
      <view class="product-content" bindtap="goToProductDetail" data-id="{{item.id}}">
        <view class="product-img-wrap">
          <image class="product-img" src="{{item.image}}" mode="aspectFill"/>
          <view class="product-tag" wx:if="{{item.tag}}">{{item.tag}}</view>
        </view>
        <view class="product-info">
          <view class="product-title">{{item.title}}</view>
          
          <!-- 服务标签 -->
          <view class="service-tags" wx:if="{{item.tags}}">
            <text class="service-tag" wx:for="{{item.tags}}" wx:key="index">{{item}}</text>
          </view>
          
          <!-- 店铺信息 -->
          <view class="shop-info">
            <text class="shop-name">{{item.shop}}</text>
            <text class="shop-score" wx:if="{{item.shopScore}}">{{item.shopScore}}分</text>
          </view>
          
          <view class="product-price-wrap">
            <text class="price-symbol">¥</text>
            <text class="product-price">{{item.price}}</text>
            <text class="product-original" wx:if="{{item.originalPrice}}">¥{{item.originalPrice}}</text>
          </view>
          
          <view class="product-commission-wrap">
            <text class="commission-tag">佣金{{item.commissionRate}}%</text>
            <text class="commission-amount">预计赚¥{{item.commissionAmount}}</text>
          </view>
          
          <view class="product-bottom">
            <view class="sales-info">
              <text class="sales-text">已售{{item.salesText}}</text>
              <text class="location" wx:if="{{item.location}}">{{item.location}}</text>
            </view>
          </view>
        </view>
      </view>
      <view class="btn-apply-wrap">
        <view class="btn-apply" bindtap="applySample" data-id="{{item.id}}">申请样品</view>
      </view>
    </view>
  </view>
</view>
