<view class="product-list-page">
  <view class="page-header">
    <view class="search-bar">
      <view class="search-icon">🔍</view>
      <input 
        class="search-input" 
        placeholder="搜索商品" 
        placeholder-class="search-placeholder" 
        bindinput="onSearch"
        bindconfirm="onSearchConfirm"
      />
      <view class="search-btn" bindtap="onSearchConfirm">搜索</view>
    </view>
  </view>

  <view class="content-container">
    <scroll-view class="category-sidebar" scroll-y="{{true}}">
      <view 
        wx:for="{{categories}}" 
        wx:key="id"
        class="category-item {{currentCategory === item.id ? 'active' : ''}}"
        bindtap="switchCategory"
        data-id="{{item.id}}"
      >
        <text class="category-name">{{item.name}}</text>
        <view class="category-indicator" wx:if="{{currentCategory === item.id}}"></view>
        <view class="category-count" wx:if="{{item.count}}">{{item.count}}</view>
      </view>
    </scroll-view>

    <scroll-view 
      class="product-content" 
      scroll-y="{{true}}"
      bindscrolltolower="loadMore"
      bindscroll="onScroll"
      scroll-top="{{scrollTop}}"
      enhanced="{{true}}"
      show-scrollbar="{{false}}"
    >
      <view class="product-grid">
        <view 
          wx:for="{{products}}" 
          wx:key="id"
          class="product-card"
          bindtap="goToDetail"
          data-id="{{item.id}}"
        >
          <view class="product-image-wrapper">
            <image class="product-image" src="{{item.image}}" mode="aspectFill" lazy-load="{{true}}" />
            <view class="product-badge-wrapper">
              <view class="product-badge" wx:if="{{item.badge}}">{{item.badge}}</view>
            </view>
            <view class="product-favorite" bindtap="toggleFavorite" data-id="{{item.id}}" catchtap="true">
              <text class="favorite-icon {{item.favorite ? 'active' : ''}}">{{item.favorite ? '♥' : '♡'}}</text>
            </view>
          </view>
          
          <view class="product-info">
            <view class="product-header">
              <view class="product-name">{{item.name}}</view>
              <view class="product-sales" wx:if="{{item.sales}}">已售{{item.sales}}</view>
            </view>
            <view class="product-desc">{{item.desc}}</view>
            
            <view class="product-price-row">
              <view class="price-container">
                <text class="price-symbol">¥</text>
                <text class="price-value">{{item.price}}</text>
                <text class="price-original" wx:if="{{item.originalPrice}}">¥{{item.originalPrice}}</text>
              </view>
              <view class="add-cart-btn" bindtap="addToCart" data-id="{{item.id}}" catchtap="true">
                <text class="add-icon">+</text>
              </view>
            </view>

            <view class="product-tags" wx:if="{{item.tags && item.tags.length > 0}}">
              <view 
                wx:for="{{item.tags}}" 
                wx:for-item="tag" 
                wx:for-index="tagIndex"
                wx:key="tagIndex"
                class="product-tag"
              >
                {{tag}}
              </view>
            </view>
          </view>
        </view>
      </view>

      <view class="loading-more" wx:if="{{loading}}">
        <view class="loading-spinner"></view>
        <text class="loading-text">加载中...</text>
      </view>

      <view class="no-more" wx:if="{{noMore && products.length > 0}}">
        <text class="no-more-text">— 已经到底啦 —</text>
      </view>

      <view class="empty-state" wx:if="{{products.length === 0 && !loading}}">
        <text class="empty-icon">📦</text>
        <text class="empty-text">暂无商品</text>
        <text class="empty-hint">换个分类试试吧</text>
      </view>
    </scroll-view>
  </view>

  <view class="back-to-top" wx:if="{{showBackToTop}}" bindtap="scrollToTop">
    <text class="back-icon">↑</text>
  </view>

  <view class="quick-actions" wx:if="{{showQuickActions}}">
    <view class="quick-action-item" bindtap="goToCart">
      <text class="action-icon">🛒</text>
      <view class="action-badge" wx:if="{{cartCount > 0}}">{{cartCount}}</view>
    </view>
    <view class="quick-action-item" bindtap="goToHome">
      <text class="action-icon">🏠</text>
    </view>
  </view>
</view>