<view class="product-list-page">
  <view class="page-background"></view>

  <view class="page-header">
    <view class="header-content">
      <view class="header-top">
        <view class="brand-section">
          <view class="brand-name">商城</view>
          <view class="brand-line"></view>
        </view>

        <view class="search-container" bindtap="goToSearchPage">
          <view class="search-wrapper">
            <text class="search-icon">✦</text>
            <text class="search-text">探索好物</text>
          </view>
        </view>

        <view class="header-actions">
          <view class="action-btn" bindtap="goToCart">
            <text class="action-icon">🛒</text>
            <view class="badge" wx:if="{{cartCount > 0}}">{{cartCount}}</view>
          </view>
        </view>
      </view>

      <view class="header-desc">精选优质商品，满足您的需求</view>
    </view>
  </view>

  <view class="banner-section">
    <view class="banner-wrapper" wx:if="{{banners.length > 0}}">
      <swiper
        class="banner-swiper"
        indicator-dots="{{bannerIndicatorDots}}"
        autoplay="{{bannerAutoplay}}"
        circular="{{bannerCircular}}"
        interval="{{bannerInterval}}"
        duration="{{bannerDuration}}"
        indicator-color="rgba(255, 255, 255, 0.4)"
        indicator-active-color="#FFFFFF"
        indicator-dots="{{true}}"
        bindchange="onBannerChange"
      >
        <swiper-item wx:for="{{banners}}" wx:key="id" bindtap="onBannerTap" data-index="{{index}}">
          <view class="banner-item-wrapper">
            <image
              class="banner-image {{item.isLoaded ? 'loaded' : ''}}"
              src="{{item.image}}"
              mode="aspectFill"
              lazy-load="{{true}}"
              bindload="onBannerImageLoad"
              binderror="onBannerImageError"
              data-index="{{index}}"

            />
            <view class="banner-overlay" wx:if="{{item.title || item.subtitle}}">
              <view class="banner-content">
                <text class="banner-title" wx:if="{{item.title}}">{{item.title}}</text>
                <text class="banner-subtitle" wx:if="{{item.subtitle}}">{{item.subtitle}}</text>
              </view>
            </view>
          </view>
        </swiper-item>
      </swiper>

      <view class="banner-indicator" wx:if="{{banners.length > 1}}">
        <view class="indicator-dots">
          <view
            wx:for="{{banners}}"
            wx:key="index"
            class="indicator-dot {{bannerCurrent === index ? 'active' : ''}}"
          ></view>
        </view>
        <text class="indicator-text">{{bannerCurrent + 1}} / {{banners.length}}</text>
      </view>

      <view class="banner-loading" wx:if="{{bannerLoading}}">
        <view class="loading-spinner"></view>
        <text class="loading-text">加载中...</text>
      </view>
    </view>

    <view class="banner-placeholder" wx:else>
      <image
        class="placeholder-image"
        src="https://picsum.photos/750/400?random=placeholder"
        mode="aspectFill"
      />
      <view class="placeholder-overlay">
        <text class="placeholder-text">暂无轮播图</text>
      </view>
    </view>
  </view>

  <view class="filter-section">
    <view class="filter-tabs">
      <view
        wx:for="{{filterTabs}}"
        wx:key="id"
        class="filter-tab {{currentFilter === item.id ? 'active' : ''}}"
        bindtap="switchFilter"
        data-id="{{item.id}}"
      >
        <text class="filter-text">{{item.name}}</text>
        <view class="filter-indicator" wx:if="{{currentFilter === item.id}}"></view>
      </view>
    </view>
  </view>

  <view class="main-container">

    <scroll-view
      class="product-scroll"
      scroll-y="{{true}}"
      scroll-top="{{productScrollTop}}"
      bindscrolltolower="loadMore"
      bindscroll="onProductScroll"
      enhanced="{{true}}"
      show-scrollbar="{{false}}"
      refresher-enabled="{{true}}"
      refresher-triggered="{{refreshing}}"
      bindrefresherrefresh="onPullDownRefresh"
      refresher-background="#FAFAFA"
    >
      <view class="product-grid">
        <view
          wx:for="{{products}}"
          wx:key="productId"
          class="product-card"
          bindtap="goToDetail"
          data-id="{{item.productId}}"
        >
          <view class="card-visual">
            <view class="image-container">
              <image class="product-image" src="{{item.mainImage}}" mode="aspectFill" lazy-load="{{true}}" />
              <view class="image-overlay">
                <view class="overlay-badges">
                  <view class="badge hot" wx:if="{{item.isHot}}">热门</view>
                  <view class="badge new" wx:if="{{item.isNew}}">新品</view>
                </view>
                <view class="overlay-actions">
                  <view class="action-favorite" bindtap="toggleFavorite" data-id="{{item.productId}}" catchtap="true">
                    <text class="favorite-icon {{item.favorite ? 'active' : ''}}">{{item.favorite ? '♥' : '♡'}}</text>
                  </view>
                </view>
              </view>
            </view>
          </view>

          <view class="card-content">
            <view class="product-name">{{item.productName}}</view>
            <view class="product-meta">
              <text class="meta-item" wx:if="{{item.sales}}">已售 {{item.sales}}</text>
              <text class="meta-divider" wx:if="{{item.sales && item.stock < 50}}">·</text>
              <text class="meta-item stock" wx:if="{{item.stock < 50}}">仅剩 {{item.stock}}</text>
            </view>

            <view class="card-footer">
              <view class="price-section">
                <text class="currency">¥</text>
                <text class="price">{{item.price}}</text>
              </view>
              <view 
                class="add-btn {{cartProductIds.includes(item.productId) ? 'in-cart' : ''}}" 
                bindtap="addToCart" 
                data-id="{{item.productId}}" 
                catchtap="true"
              >
                <text class="add-icon">{{cartProductIds.includes(item.productId) ? '✓' : '＋'}}</text>
              </view>
            </view>
          </view>
        </view>
      </view>

      <view class="loading-state" wx:if="{{loading}}">
        <view class="loading-dots">
          <view class="dot"></view>
          <view class="dot"></view>
          <view class="dot"></view>
        </view>
      </view>

      <view class="end-state" wx:if="{{noMore && products.length > 0}}">
        <view class="end-line"></view>
        <text class="end-text">已加载全部</text>
        <view class="end-line"></view>
      </view>

      <view class="empty-state" wx:if="{{products.length === 0 && !loading}}">
        <text class="empty-emoji">✨</text>
        <text class="empty-title">暂无商品</text>
        <text class="empty-desc">探索更多精彩好物</text>
      </view>
    </scroll-view>
  </view>
</view>