<view class="sp-search-result">
  <!-- 搜索头部 -->
  <view class="result-header">
    <view class="search-box" bindtap="goBack">
      <icon type="search" size="16" color="#999" class="search-icon"/>
      <text class="search-keyword">{{keyword}}</text>
    </view>
    <view class="back-btn" bindtap="goBack">取消</view>
  </view>

  <!-- 搜索结果统计 -->
  <view class="result-count" wx:if="{{products.length > 0}}">
    <text>共找到 {{products.length}} 件相关商品</text>
  </view>

  <!-- 商品列表 - 单列卡片布局 -->
  <scroll-view 
    class="product-list"
    scroll-y="{{true}}"
    bindscrolltolower="onReachBottom"
    enable-back-to-top="{{true}}"
  >
    <!-- 商品卡片 -->
    <view
      class="product-card"
      wx:for="{{products}}"
      wx:key="productId"
      bindtap="goToDetail"
      data-id="{{item.productId || item.id}}"
    >
      <!-- 商品图片 -->
      <view class="card-image">
        <image
          src="{{item.mainImage || item.image}}"
          mode="aspectFill"
          lazy-load="{{true}}"
        />
        <view class="product-tag" wx:if="{{item.isNew || item.isHot}}">
          <text wx:if="{{item.isNew}}">新品</text>
          <text wx:if="{{item.isHot}}">热销</text>
        </view>
      </view>

      <!-- 商品信息 -->
      <view class="card-info">
        <!-- 商品名称 -->
        <view class="product-name">
          <text>{{item.productName || item.name}}</text>
        </view>

        <!-- 商品简介 -->
        <view class="product-brief" wx:if="{{item.brief}}">
          <text>{{item.brief}}</text>
        </view>

        <!-- 价格和销量 -->
        <view class="product-meta">
          <view class="price-row">
            <text class="current-price">¥{{item.memberPrice || item.price}}</text>
            <text class="original-price" wx:if="{{item.originalPrice}}">¥{{item.originalPrice}}</text>
          </view>
          <view class="sales-info">
            <text class="sales">已售{{item.sales || 0}}</text>
            <text class="stock" wx:if="{{item.stock}}">库存{{item.stock}}</text>
          </view>
        </view>

        <!-- 标签 -->
        <view class="product-tags" wx:if="{{item.tags && item.tags.length > 0}}">
          <text class="tag" wx:for="{{item.tags}}" wx:for-item="tag" wx:key="index">{{tag}}</text>
        </view>

        <!-- 操作按钮 -->
        <view class="card-actions">
          <view class="action-btn add-cart" catchtap="addToCart" data-id="{{item.productId || item.id}}">
            <text>加入购物车</text>
          </view>
          <view class="action-btn buy-now" catchtap="goToDetail" data-id="{{item.productId || item.id}}">
            <text>立即购买</text>
          </view>
        </view>
      </view>
    </view>

    <!-- 加载状态 -->
    <view class="loading-state" wx:if="{{loading}}">
      <text>加载中...</text>
    </view>

    <!-- 空状态 -->
    <view class="empty-state" wx:if="{{!loading && products.length === 0}}">
      <text class="empty-icon">🔍</text>
      <text class="empty-text">未找到相关商品</text>
      <text class="empty-hint">换个关键词试试吧</text>
    </view>

    <!-- 没有更多 -->
    <view class="no-more" wx:if="{{!hasMore && products.length > 0}}">
      <text>没有更多了</text>
    </view>
  </scroll-view>

  <!-- 购物车入口 -->
  <view class="cart-float" bindtap="goToCart" wx:if="{{cartCount > 0}}">
    <view class="cart-icon-wrapper">
      <text class="cart-icon">🛒</text>
      <view class="cart-badge">
        <text>{{cartCount > 99 ? '99+' : cartCount}}</text>
      </view>
    </view>
  </view>
</view>
