<view class="page">
  <!-- 用户信息 -->
  <view class="user-section">
    <view class="user-info">
      <image class="avatar" src="https://picsum.photos/120/120?random=99"/>
      <view class="user-detail">
        <text class="nickname">达人用户</text>
        <view class="level-tag">
          <text class="level-text">优质达人</text>
        </view>
      </view>
    </view>
    <view class="user-stats">
      <view class="stat-item">
        <text class="stat-num">1.2万</text>
        <text class="stat-label">粉丝</text>
      </view>
      <view class="stat-item">
        <text class="stat-num">856</text>
        <text class="stat-label">带货订单</text>
      </view>
      <view class="stat-item">
        <text class="stat-num">98%</text>
        <text class="stat-label">好评率</text>
      </view>
    </view>
  </view>

  <!-- 功能入口 -->
  <view class="menu-section">
    <view class="menu-group">
      <view class="menu-title">样品管理</view>
      <view class="menu-list">
        <view class="menu-item" bindtap="goToMySamples">
          <view class="menu-icon sample">🎁</view>
          <text class="menu-text">我的样品</text>
          <view class="menu-badge" wx:if="{{sampleCount > 0}}">{{sampleCount}}</view>
          <text class="arrow">></text>
        </view>
        <view class="menu-item" bindtap="goToSampleApply">
          <view class="menu-icon apply">📝</view>
          <text class="menu-text">申请记录</text>
          <text class="arrow">></text>
        </view>
      </view>
    </view>

    <view class="menu-group">
      <view class="menu-title">订单管理</view>
      <view class="menu-list">
        <view class="menu-item">
          <view class="menu-icon order">📦</view>
          <text class="menu-text">我的订单</text>
          <text class="arrow">></text>
        </view>
        <view class="menu-item">
          <view class="menu-icon data">📊</view>
          <text class="menu-text">带货数据</text>
          <text class="arrow">></text>
        </view>
        <view class="menu-item">
          <view class="menu-icon fan">👥</view>
          <text class="menu-text">粉丝数据</text>
          <text class="arrow">></text>
        </view>
      </view>
    </view>

    <view class="menu-group">
      <view class="menu-title">服务中心</view>
      <view class="menu-list">
        <view class="menu-item">
          <view class="menu-icon help">❓</view>
          <text class="menu-text">帮助中心</text>
          <text class="arrow">></text>
        </view>
        <view class="menu-item">
          <view class="menu-icon service">💬</view>
          <text class="menu-text">联系客服</text>
          <text class="arrow">></text>
        </view>
        <view class="menu-item">
          <view class="menu-icon setting">⚙️</view>
          <text class="menu-text">设置</text>
          <text class="arrow">></text>
        </view>
      </view>
    </view>
  </view>
</view>
