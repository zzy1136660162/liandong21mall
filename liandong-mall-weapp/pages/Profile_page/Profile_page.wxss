page {
  background: #FAFAFA;
  min-height: 100vh;
}

.profile-page {
  min-height: 100vh;
  position: relative;
  overflow: hidden;
}

.page-background {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: #FFFFFF;
  z-index: 0;
}

.page-header {
  position: relative;
  z-index: 10;
  background: #FFFFFF;
  border-bottom: 1rpx solid rgba(0, 0, 0, 0.06);
}

.header-content {
  padding: 48rpx 40rpx 32rpx;
}

.header-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 24rpx;
}

.brand-section {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.brand-name {
  font-size: 56rpx;
  color: #1A1A1A;
  font-weight: 300;
  letter-spacing: 4rpx;
}

.brand-line {
  width: 60rpx;
  height: 4rpx;
  background: #1A1A1A;
  border-radius: 2rpx;
}

.header-actions {
  display: flex;
  gap: 16rpx;
}

.action-btn {
  width: 72rpx;
  height: 72rpx;
  background: #F5F5F5;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
}

.action-icon {
  font-size: 32rpx;
  opacity: 0.6;
}

.header-desc {
  font-size: 26rpx;
  color: #999999;
  letter-spacing: 1rpx;
  font-weight: 400;
}

.page-content {
  position: relative;
  z-index: 1;
  padding: 32rpx 24rpx 120rpx;
}

.user-info-section {
  margin-bottom: 32rpx;
}

.user-card {
  background: linear-gradient(135deg, #1A1A1A 0%, #4A4A4A 100%);
  border-radius: 32rpx;
  padding: 40rpx;
  display: flex;
  align-items: center;
  gap: 24rpx;
  box-shadow: 0 8rpx 32rpx rgba(0, 0, 0, 0.12);
}

.user-avatar {
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
  overflow: hidden;
  flex-shrink: 0;
  border: 4rpx solid rgba(255, 255, 255, 0.2);
}

.avatar-image {
  width: 100%;
  height: 100%;
}

.user-detail {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.user-name {
  font-size: 36rpx;
  color: #FFFFFF;
  font-weight: 600;
  letter-spacing: 1rpx;
}

.user-level {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.8);
  font-weight: 400;
  letter-spacing: 0.5rpx;
}

.user-stats {
  display: flex;
  gap: 32rpx;
}

.stat-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
}

.stat-value {
  font-size: 32rpx;
  color: #FFFFFF;
  font-weight: 600;
  letter-spacing: 0.5rpx;
}

.stat-label {
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.7);
  font-weight: 400;
  letter-spacing: 0.3rpx;
}

.order-section {
  margin-bottom: 32rpx;
}

.section-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 24rpx;
  padding: 0 8rpx;
}

.section-title {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.title-text {
  font-size: 36rpx;
  color: #1A1A1A;
  font-weight: 600;
  letter-spacing: 1rpx;
}

.title-decoration {
  width: 40rpx;
  height: 4rpx;
  background: #1A1A1A;
  border-radius: 2rpx;
}

.section-more {
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.more-text {
  font-size: 26rpx;
  color: #999999;
  font-weight: 400;
  letter-spacing: 0.5rpx;
}

.more-arrow {
  font-size: 24rpx;
  color: #999999;
}

.order-status-bar {
  background: #FFFFFF;
  border-radius: 24rpx;
  padding: 32rpx 24rpx;
  display: flex;
  justify-content: space-around;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.04);
}

.order-status-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 12rpx;
  position: relative;
}

.status-icon {
  font-size: 48rpx;
}

.status-text {
  font-size: 24rpx;
  color: #666666;
  font-weight: 400;
  letter-spacing: 0.3rpx;
}

.status-badge {
  position: absolute;
  top: -8rpx;
  right: -8rpx;
  min-width: 32rpx;
  height: 32rpx;
  background: #FF4D4F;
  border-radius: 16rpx;
  padding: 0 8rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 20rpx;
  color: #FFFFFF;
  font-weight: 600;
  letter-spacing: 0.3rpx;
}

.menu-section {
  margin-bottom: 32rpx;
}

.menu-container {
  background: #FFFFFF;
  border-radius: 16rpx;
  margin: 20rpx 20rpx 0;
  overflow: hidden;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.04);
}

.menu-item {
  position: relative;
  height: 100rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 30rpx;
}

.menu-item-hover {
  background: #F5F5F5;
}

.menu-left {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.menu-icon {
  font-size: 40rpx;
  color: #666666;
}

.menu-text {
  font-size: 28rpx;
  color: #333333;
  font-weight: 400;
  letter-spacing: 0.5rpx;
}

.menu-arrow {
  font-size: 28rpx;
  color: #999999;
  flex-shrink: 0;
}

.menu-divider {
  position: absolute;
  bottom: 0;
  left: 30rpx;
  right: 0;
  height: 1rpx;
  background: #F5F5F5;
}

.menu-item:last-child .menu-divider {
  display: none;
}
