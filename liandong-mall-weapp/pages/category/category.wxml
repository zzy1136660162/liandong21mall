<view class="page">
  <!-- 状态栏占位 -->
  <view class="status-bar" style="height: {{statusBarHeight}}rpx;"></view>

  <!-- 顶部搜索栏 -->
  <view class="search-bar">
    <view class="search-box" bindtap="goToSearch">
      <text class="search-icon">🔍</text>
      <text class="search-text">搜索商品</text>
    </view>
    <image class="camera-btn" src="https://www.lslnii.com/upload/NFSImgFile/appl/images/2025/12/20260319090524623_666695127685.png" mode="aspectFit" bindtap="takePhoto"></image>
  </view>

  <!-- 主分类标签 -->
  <scroll-view class="category-scroll" scroll-x enhanced show-scrollbar="{{false}}">
    <view class="category-list">
      <view class="category-item {{currentMainCategory === 'all' ? 'active' : ''}}" bindtap="goToHome">
        <text class="category-text">首页</text>
      </view>
      <view class="category-item {{currentMainCategory === 'nasal_care' ? 'active' : ''}}" bindtap="switchMainCategory" data-category="nasal_care">
        <text class="category-text">鼻部护理</text>
      </view>
      <view class="category-item {{currentMainCategory === 'pain_relief' ? 'active' : ''}}" bindtap="switchMainCategory" data-category="pain_relief">
        <text class="category-text">缓解疼痛</text>
      </view>
      <view class="category-item {{currentMainCategory === 'eye_care' ? 'active' : ''}}" bindtap="switchMainCategory" data-category="eye_care">
        <text class="category-text">护眼</text>
      </view>
      <view class="category-item {{currentMainCategory === 'sub_health' ? 'active' : ''}}" bindtap="switchMainCategory" data-category="sub_health">
        <text class="category-text">调理亚健康</text>
      </view>
      <view class="category-item {{currentMainCategory === 'kidney_care' ? 'active' : ''}}" bindtap="switchMainCategory" data-category="kidney_care">
        <text class="category-text">固肾养肾</text>
      </view>
      <view class="category-item {{currentMainCategory === 'body_odor' ? 'active' : ''}}" bindtap="switchMainCategory" data-category="body_odor">
        <text class="category-text">狐臭护理</text>
      </view>
      <view class="category-item {{currentMainCategory === 'skin_care' ? 'active' : ''}}" bindtap="switchMainCategory" data-category="skin_care">
        <text class="category-text">美肤护肤</text>
      </view>
      <view class="category-item {{currentMainCategory === 'facial_rehab' ? 'active' : ''}}" bindtap="switchMainCategory" data-category="facial_rehab">
        <text class="category-text">面瘫康复</text>
      </view>
      <view class="category-item {{currentMainCategory === 'women_health' ? 'active' : ''}}" bindtap="switchMainCategory" data-category="women_health">
        <text class="category-text">女性调理</text>
      </view>
      <view class="category-item {{currentMainCategory === 'solid_drink' ? 'active' : ''}}" bindtap="switchMainCategory" data-category="solid_drink">
        <text class="category-text">固体饮料</text>
      </view>
      <view class="category-item {{currentMainCategory === 'tablet_candy' ? 'active' : ''}}" bindtap="switchMainCategory" data-category="tablet_candy">
        <text class="category-text">压片糖果</text>
      </view>
      <view class="category-item {{currentMainCategory === 'herbal_paste' ? 'active' : ''}}" bindtap="switchMainCategory" data-category="herbal_paste">
        <text class="category-text">膏滋</text>
      </view>
      <view class="category-item {{currentMainCategory === 'herbal_drink' ? 'active' : ''}}" bindtap="switchMainCategory" data-category="herbal_drink">
        <text class="category-text">植物饮品</text>
      </view>
      <view class="category-item {{currentMainCategory === 'prepared_wine' ? 'active' : ''}}" bindtap="switchMainCategory" data-category="prepared_wine">
        <text class="category-text">配制酒</text>
      </view>
      <view class="category-item {{currentMainCategory === 'tea_substitute' ? 'active' : ''}}" bindtap="switchMainCategory" data-category="tea_substitute">
        <text class="category-text">代用茶</text>
      </view>
    </view>
  </scroll-view>

  <!-- 商品列表 -->
  <view class="product-list">
    <view class="product-item" wx:for="{{products}}" wx:key="id" bindtap="goToProductDetail" data-id="{{item.id}}">
      <view class="product-image-wrap">
        <image class="product-image" src="{{item.image}}" mode="aspectFill"/>
        <view class="product-badge" wx:if="{{item.badge}}">{{item.badge}}</view>
      </view>
      <view class="product-info">
        <!-- 榜单标签 -->
        <view class="rank-tag" wx:if="{{item.rankTag}}">
          <text class="rank-icon">🏆</text>
          <text>{{item.rankTag}}</text>
          <text class="rank-arrow">></text>
        </view>
        <!-- 标签 -->
        <view class="product-tags">
          <view class="tag cashback" wx:if="{{item.cashback}}">单单返现</view>
          <view class="tag trust" wx:if="{{item.trust}}">信任购</view>
          <view class="tag brand" wx:if="{{item.isBrand}}">品牌</view>
        </view>
        <!-- 标题 -->
        <view class="product-title">{{item.title}}</view>
        <!-- 佣金信息 -->
        <view class="commission-row">
          <text class="commission-text">赚¥{{item.commissionAmount}}</text>
          <text class="commission-rate">{{item.commissionRate}}%佣</text>
        </view>
        <!-- 价格销量 -->
        <view class="price-row">
          <text class="price-label">售价¥{{item.price}}</text>
          <text class="sales-text">{{item.salesText}}</text>
        </view>
        <!-- 加入货架按钮 -->
        <view class="add-btn" catchtap="addToShelf" data-id="{{item.id}}">加入货架</view>
      </view>
    </view>
  </view>

  <!-- 底部安全区域 -->
  <view class="safe-area"></view>
</view>
