<view class="page">
  <view class="activity-banner">
    <image class="banner-image" src="https://picsum.photos/750/300?random=400" mode="aspectFill"/>
    <view class="banner-overlay">
      <text class="banner-title">商家优选</text>
      <text class="banner-subtitle">官方认证优质商家，品质有保障</text>
    </view>
  </view>
  <view class="activity-stats">
    <view class="stat-item"><text class="stat-number">{{stats.merchantCount}}</text><text class="stat-label">认证商家</text></view>
    <view class="stat-item"><text class="stat-number">{{stats.qualityRate}}%</text><text class="stat-label">好评率</text></view>
    <view class="stat-item"><text class="stat-number">{{stats.returnRate}}%</text><text class="stat-label">退货率</text></view>
  </view>
